---
import { VISIBLE_AREAS } from '@/content/nav.mjs';
import { SITE } from '@/lib/site';

const columns = [
    { title: 'Docs', links: [['All areas', '/docs/'], ...VISIBLE_AREAS.filter((a) => a.id !== 'reference').map((a) => [a.title, `/docs/${a.id}/`])] },
    { title: 'Reference', links: [['API reference', '/api/'], ['Glossary', '/docs/glossary/'], ['FAQ', '/faq/'], ['Changelog', '/changelog/'], ['llms.txt', '/llms.txt'], ['llms-full.txt', '/llms-full.txt']] },
    { title: 'Examples', links: [['Showcase', '/showcase/'], ['Widget viewer', '/lab/35-widget-viewer/'], ['Lab', '/lab/']] },
    { title: 'Project', links: [['GitHub', SITE.githubRepo], ['npm', SITE.npm]] },
];
---

<footer class="mt-24 border-t">
    <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
        <div>
            <div class="font-semibold">{SITE.name}</div>
            <p class="mt-2 max-w-xs text-sm text-muted-foreground">{SITE.tagline}. Exact anti-aliasing at any zoom, rotation and pixel ratio.</p>
        </div>
        {columns.map((col) => (
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{col.title}</div>
                <ul class="mt-3 space-y-2 text-sm">
                    {col.links.map(([label, href]) => <li><a href={href} class="text-foreground/80 hover:text-foreground">{label}</a></li>)}
                </ul>
            </div>
        ))}
    </div>
    <div class="container-page flex flex-wrap justify-between gap-2 border-t py-6 text-xs text-muted-foreground">
        <span>MIT licensed.</span>
        <span>Built with Astro, React and PixiJS, rendered with pixi-silk.</span>
    </div>
</footer>
