---
import { docsSections } from '@/components/sections';
import { SITE } from '@/lib/site';

const sections = await docsSections();
// one column per section: its areas, or its pages when the section is a single area
const columns = sections.map((s) => ({
    title: s.title,
    href: s.href,
    links:
        s.areas.length > 1
            ? s.areas.map((a) => [a.title, a.href])
            : s.areas.flatMap((a) => [...a.pages.map((p) => [p.title, p.href]), ...a.links.map((l) => [l.label, l.href])]).slice(0, 6),
}));
const project = [
    ['Studio', '/studio/'],
    ['FAQ', '/faq/'],
    ['Changelog', '/changelog/'],
    ['llms.txt', '/llms.txt'],
    ['GitHub', SITE.githubRepo],
    ['npm', SITE.npm],
];
---

<footer class="mt-28 border-t">
    <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(5,1fr)]">
        <div>
            <a href="/" class="text-[15px] font-bold tracking-tight">pixi-<span class="silk-text">silk</span></a>
            <p class="mt-3 max-w-[16rem] text-sm leading-relaxed text-muted-foreground">{SITE.tagline}.</p>
        </div>
        {columns.map((col) => (
            <div>
                <a href={col.href} class="block font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground hover:text-foreground">{col.title}</a>
                <ul class="mt-4 space-y-2.5 text-sm">
                    {col.links.map(([label, href]) => <li><a href={href} class="text-foreground/75 hover:text-foreground">{label}</a></li>)}
                </ul>
            </div>
        ))}
        <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Project</div>
            <ul class="mt-4 space-y-2.5 text-sm">
                {project.map(([label, href]) => <li><a href={href} class="text-foreground/75 hover:text-foreground">{label}</a></li>)}
            </ul>
        </div>
    </div>
    <div class="container-page flex flex-wrap justify-between gap-2 border-t py-6 text-xs text-muted-foreground">
        <span>MIT licensed.</span>
        <span>Built with Astro, React and PixiJS, drawn with pixi-silk.</span>
    </div>
</footer>
