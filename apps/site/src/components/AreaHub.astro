---
import { areaThumb, pageThumb, type Section, type SectionArea } from '@/components/sections';
import ThumbCard from '@/components/ThumbCard.astro';
import { FAQ } from '@/content/faq.mjs';

/**
 * An area's overview at `/docs/<area>/`: its introduction, then one card per page
 * (thumbnail, title, one line). Demos run on the pages themselves, never here.
 */
interface Props {
    area: SectionArea;
    section?: Section;
}
const { area, section } = Astro.props;
// the area that owns its section's URL (Reference, say) also leads to the section's other areas
const others = section && section.id === area.id ? section.areas.filter((a) => a.id !== area.id) : [];
const questions = FAQ.filter((f) => f.area === area.id);
const html = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---

{area.intro.map((p) => <p>{p}</p>)}

{area.pages.length > 0 && (
    <div class="not-prose mt-8 grid gap-4 sm:grid-cols-2" data-pagefind-ignore>
        {area.pages.map((p) => <ThumbCard href={p.href} title={p.title} description={p.description} thumb={pageThumb(p)} />)}
    </div>
)}

{area.links.length > 0 && (
    <section class="not-prose mt-12">
        <h2 class="eyebrow mb-4">{area.pages.length > 0 ? 'Also here' : 'Open'}</h2>
        <div class="grid gap-3 sm:grid-cols-2">
            {area.links.map((l) => (
                <a href={l.href} class="card-link p-4">
                    <div class="font-semibold text-foreground">{l.label}</div>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{l.description}</p>
                </a>
            ))}
        </div>
    </section>
)}

{others.map((o) => (
    <section class="not-prose mt-14">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="heading-4"><a href={o.href} class="hover:text-silk-text">{o.title}</a></h2>
            <a href={o.href} class="text-sm text-muted-foreground hover:text-foreground">Overview</a>
        </div>
        <p class="mt-1.5 text-sm text-muted-foreground">{o.summary}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {o.pages.map((p) => <ThumbCard href={p.href} title={p.title} description={p.description} thumb={pageThumb(p) ?? areaThumb(o)} />)}
        </div>
    </section>
))}

{questions.length > 0 && (
    <section class="not-prose mt-14">
        <h2 class="eyebrow mb-2">Questions</h2>
        <div class="divide-y border-y">
            {questions.map((q) => (
                <details class="group py-3">
                    <summary class="flex cursor-pointer list-none items-start gap-2 font-medium text-foreground marker:hidden">
                        <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                        {q.q}
                    </summary>
                    <p class="mt-2 pl-5.5 text-sm leading-relaxed text-muted-foreground" set:html={html(q.a)} />
                </details>
            ))}
        </div>
        <a href={`/faq/#${area.id}`} class="link-arrow mt-4">All questions</a>
    </section>
)}
