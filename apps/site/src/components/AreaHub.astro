---
import Demo from '@/components/Demo.astro';
import { FAQ } from '@/content/faq.mjs';
import type { Area } from '@/lib/docs';

interface Props {
    area: Area;
}
const { area } = Astro.props;
const arrow = 'M5 12h14M13 6l6 6-6 6';
const questions = FAQ.filter((f) => f.area === area.id);
const html = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---

{area.intro.map((p) => <p>{p}</p>)}

{area.pages.length > 1 && (
    <nav aria-label={`${area.title} in order`} class="not-prose mt-8 flex flex-wrap gap-2" data-pagefind-ignore>
        {area.pages.map((p, i) => (
            <a href={`#${p.slug}`} class="rounded-full border px-3 py-1 text-xs text-muted-foreground no-underline transition-colors hover:border-foreground/30 hover:text-foreground">
                <span class="font-mono text-silk">{String(i + 1).padStart(2, '0')}</span> {p.title}
            </a>
        ))}
    </nav>
)}

{area.pages.map((p, i) => (
    <section id={p.slug} class="not-prose mt-14 scroll-mt-24">
        <div class="font-mono text-xs text-silk">{String(i + 1).padStart(2, '0')}</div>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight"><a href={p.href} class="no-underline hover:underline">{p.title}</a></h2>
        <p class="mt-2 leading-relaxed text-muted-foreground">{p.description}</p>
        {p.demo && <Demo name={p.demo.name} height={p.demo.height} caption={p.demo.caption} compact />}
        <div class:list={['flex flex-wrap items-center gap-2', p.demo ? 'mt-0' : 'mt-5']}>
            <a href={p.href} class="group inline-flex items-center gap-1.5 rounded-lg bg-foreground px-3.5 py-2 text-sm font-semibold text-background no-underline">
                Read the guide
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
            </a>
            {p.lab.map((l) => (
                <a href={l.href} title={l.description} class="rounded-lg border px-3 py-2 text-sm text-muted-foreground no-underline transition-colors hover:border-foreground/30 hover:text-foreground">
                    <span class="font-mono text-[11px] text-silk">Lab {l.slug.slice(0, 2)}</span> {l.name}
                </a>
            ))}
        </div>
    </section>
))}

{area.links.length > 0 && (
    <section class="not-prose mt-14">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{area.pages.length > 0 ? 'Also in this area' : 'Open'}</h2>
        <div class="grid gap-3 sm:grid-cols-2">
            {area.links.map((l) => (
                <a href={l.href} class="rounded-xl border bg-card p-5 no-underline transition-all hover:-translate-y-0.5 hover:border-foreground/30">
                    <div class="font-semibold text-foreground">{l.label}</div>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{l.description}</p>
                </a>
            ))}
        </div>
    </section>
)}

{questions.length > 0 && (
    <section class="not-prose mt-14">
        <h2 class="mb-1 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Questions about {area.title.toLowerCase()}</h2>
        <div class="divide-y border-y">
            {questions.map((q) => (
                <details class="group py-3">
                    <summary class="cursor-pointer list-none font-medium text-foreground marker:hidden">
                        <span class="mr-2 inline-block text-muted-foreground transition-transform group-open:rotate-90">›</span>{q.q}
                    </summary>
                    <p class="mt-2 pl-5 text-sm leading-relaxed text-muted-foreground" set:html={html(q.a)} />
                </details>
            ))}
        </div>
        <a href={`/faq/#${area.id}`} class="mt-3 inline-block text-sm text-muted-foreground hover:text-foreground">All questions</a>
    </section>
)}
