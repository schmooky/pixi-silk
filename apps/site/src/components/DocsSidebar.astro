---
/**
 * The docs sidebar: the current section's groups (its areas), each with its pages.
 * On narrow screens the same list folds into a menu above the article.
 */
export interface SidebarItem {
    label: string;
    href: string;
}
export interface SidebarGroup {
    title: string;
    /** The group's hub page, linked from its title. */
    href?: string;
    badge?: string;
    items: SidebarItem[];
}
interface Props {
    /** Label above the groups: the section name. */
    heading?: string;
    headingHref?: string;
    groups: SidebarGroup[];
    pathname: string;
}
const { heading, headingHref, groups, pathname } = Astro.props;
const isActive = (href: string) => pathname === href || pathname === href.replace(/\/$/, '');
const current = groups.flatMap((g) => g.items).find((i) => isActive(i.href)) ?? groups.find((g) => g.href && isActive(g.href));
const currentLabel = current ? ('label' in current ? current.label : current.title) : undefined;
const summary = [heading, currentLabel].filter(Boolean).join(': ') || 'Menu';
---

<aside class="md:sticky md:top-14 md:max-h-[calc(100vh-3.5rem)] md:self-start md:overflow-y-auto md:pb-10 md:pt-10" data-pagefind-ignore>
    <details class="group rounded-lg border md:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2.5 text-sm font-medium marker:hidden">
            <span class="truncate">{summary}</span>
            <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="border-t px-3 pb-3 pt-1"><slot name="mobile" /></div>
    </details>
    <nav aria-label="Docs" class="hidden text-sm md:block">
        {heading && (
            headingHref
                ? <a href={headingHref} class="eyebrow mb-5 block hover:underline">{heading}</a>
                : <div class="eyebrow mb-5">{heading}</div>
        )}
        {groups.map((group) => (
            <div class="mb-7">
                {group.href ? (
                    <a href={group.href} aria-current={isActive(group.href) ? 'page' : undefined} class:list={[
                        'mb-2 flex items-center gap-2 font-semibold transition-colors',
                        isActive(group.href) ? 'text-silk-text' : 'text-foreground hover:text-silk-text',
                    ]}>
                        {group.title}
                        {group.badge && <span class="badge">{group.badge}</span>}
                    </a>
                ) : (
                    <div class="mb-2 font-semibold text-foreground">{group.title}</div>
                )}
                <ul class="border-l">
                    {group.items.map((item) => (
                        <li>
                            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[
                                '-ml-px block border-l py-[5px] pl-3.5 leading-snug transition-colors',
                                isActive(item.href) ? 'border-silk font-medium text-foreground' : 'border-transparent text-muted-foreground hover:border-foreground/30 hover:text-foreground',
                            ]}>
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </nav>
</aside>
