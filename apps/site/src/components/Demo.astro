---
import DemoRunner from '@/components/react/DemoRunner';

interface Props {
    /** File name in src/demos without `.demo.ts`. */
    name: string;
    height?: number;
    caption?: string;
}
const { name, height = 280, caption } = Astro.props;
const sources = import.meta.glob<string>('../demos/*.demo.ts', { query: '?raw', import: 'default' });
const load = sources[`../demos/${name}.demo.ts`];

if (!load) {
    const known = Object.keys(sources).map((k) => k.replace('../demos/', '').replace('.demo.ts', ''));

    throw new Error(`<Demo name="${name}"> not found. Known demos: ${known.join(', ')}`);
}
// the bar under the canvas exists only for demos with controls; knowing it now keeps the page from jumping
const hasControls = /\bcontrols\s*:\s*\{\s*[\w'"]/.test(await load());
const label = caption ?? `Live pixi-silk demo: ${name.replace(/-/g, ' ')}`;
---

<figure class="demo not-prose my-8" data-demo={name} id={`demo-${name}`}>
    <div class="overflow-hidden rounded-xl border bg-card">
        <DemoRunner client:visible={{ rootMargin: '300px' }} name={name} height={height} label={label} hasControls={hasControls} studio={`/studio/?demo=${name}`} />
    </div>
    {caption && <figcaption class="mt-2.5 px-1 text-[13px] leading-relaxed text-muted-foreground">{caption}</figcaption>}
</figure>
