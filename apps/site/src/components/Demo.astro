---
import { Code } from 'astro:components';
import DemoRunner from '@/components/react/DemoRunner';

interface Props {
    /** File name in src/demos without `.demo.ts`. */
    name: string;
    height?: number;
    caption?: string;
    /** Leave out the source panel (feature tours, where the guide has the code). */
    compact?: boolean;
}
const { name, height = 280, caption, compact = false } = Astro.props;
const sources = import.meta.glob<string>('../demos/*.demo.ts', { query: '?raw', import: 'default', eager: true });
const code = sources[`../demos/${name}.demo.ts`];

if (!code) {
    const known = Object.keys(sources).map((k) => k.replace('../demos/', '').replace('.demo.ts', ''));

    throw new Error(`<Demo name="${name}"> not found. Known demos: ${known.join(', ')}`);
}
---

<figure class="demo not-prose my-7 overflow-hidden rounded-xl border bg-card" data-demo={name} id={`demo-${name}`}>
    <DemoRunner client:visible={{ rootMargin: '300px' }} name={name} height={height} label={caption ?? `Live pixi-silk demo: ${name.replace(/-/g, ' ')}`} />
    {!compact && (
        <details class="demo-code border-t">
            <summary class="cursor-pointer select-none px-4 py-2.5 text-xs text-muted-foreground hover:text-foreground">
                Source <span class="font-mono">src/demos/{name}.demo.ts</span>
            </summary>
            <Code code={code.trim()} lang="ts" theme="github-dark-dimmed" class="demo-source" />
        </details>
    )}
    {caption && <figcaption class="border-t px-4 py-2.5 text-xs text-muted-foreground">{caption}</figcaption>}
</figure>

<style>
    .demo :global(.demo-source) { margin: 0; max-height: 460px; overflow: auto; border-radius: 0; padding: 1rem 1.1rem; font-size: 12.5px; line-height: 1.6; }
</style>
