---
import { FAQ } from '@/content/faq.mjs';
import { VISIBLE_AREAS } from '@/content/nav.mjs';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd, faqLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const description = `Answers about anti-aliasing and smooth graphics in PixiJS v8: MSAA vs SDF, jagged or blurry edges, squircles, banding-free gradients, glows, retina.`;
const html = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// answers are grouped by the docs area they belong to, in the order the docs read
const groups = VISIBLE_AREAS.map((a) => ({ area: a, items: FAQ.filter((f) => f.area === a.id) })).filter((g) => g.items.length > 0);
const orphans = FAQ.filter((f) => !VISIBLE_AREAS.some((a) => a.id === f.area));

if (orphans.length) throw new Error(`src/content/faq.mjs: unknown area on [${orphans.map((f) => f.q).join(' | ')}]`);
---

<Base title={`PixiJS anti-aliasing and smooth graphics FAQ | ${SITE.name}`} description={description} path="/faq/" jsonLd={[faqLd(FAQ), breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'FAQ', url: '/faq/' }])]}>
    <div class="container-page max-w-3xl py-14" data-pagefind-body data-pagefind-filter="section:FAQ">
        <h1 class="text-4xl font-semibold tracking-tight">Frequently asked questions</h1>
        <p class="mt-3 text-muted-foreground">{description} Answers are grouped by docs area, and each area overview shows its own.</p>
        <nav aria-label="FAQ areas" class="mt-8 flex flex-wrap gap-2" data-pagefind-ignore>
            {groups.map((g) => <a href={`#${g.area.id}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground">{g.area.title}</a>)}
        </nav>
        {groups.map((g) => (
            <section id={g.area.id} class="mt-12 scroll-mt-20">
                <div class="flex flex-wrap items-baseline justify-between gap-3 border-b pb-2">
                    <h2 class="text-xl font-semibold tracking-tight">{g.area.title}</h2>
                    <a href={`/docs/${g.area.id}/`} class="text-sm text-muted-foreground hover:text-foreground">Area overview</a>
                </div>
                <div class="prose-docs">
                    {g.items.map((item) => (
                        <section id={slug(item.q)} class="border-b py-2">
                            <h3 class="!mt-6 !text-lg">{item.q}<a class="heading-anchor" href={`#${slug(item.q)}`} aria-label={`Permalink to "${item.q}"`} data-pagefind-ignore>#</a></h3>
                            <p set:html={html(item.a)} />
                        </section>
                    ))}
                </div>
            </section>
        ))}
    </div>
</Base>
