---
import { Code } from 'astro:components';
import CopyCommand from '@/components/CopyCommand.astro';
import HeroCanvas from '@/components/react/HeroCanvas';
import { areaThumb, docsSections, pageThumb, siteThumb } from '@/components/sections';
import ThumbCard from '@/components/ThumbCard.astro';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd, softwareApplicationLd, softwareLd, webSiteLd } from '@/lib/seo';
import { SITE } from '@/lib/site';
import { SILK_VERSION } from '@/lib/version';

const sections = await docsSections();
const learn = sections.find((s) => s.id === 'learn');
const features = sections.find((s) => s.id === 'features');
const examples = sections.find((s) => s.id === 'examples');
const start = learn?.areas[0]?.pages[0]?.href ?? learn?.href ?? '/docs/';
const examplePages = (examples?.areas ?? []).flatMap((a) => a.pages);

const code = `import { createSilkApp, SilkGraphics, conic } from 'pixi-silk';

const stage = document.getElementById('stage')!;
const { app } = await createSilkApp({ parent: stage });
const gauge = conic([0x30d158, 0xffd60a, 0xff453a]);
const g = new SilkGraphics();

// a squircle card, and a ring whose gradient follows the arc
g.roundRect(10, 10, 340, 140, 22, 0.6).fill(0x1c1c1e);
g.arcSweep(80, 80, 44, -Math.PI / 2, Math.PI * 1.5)
    .stroke({ width: 12, cap: 'round', gradient: gauge });

app.stage.addChild(g);`;

const points = [
    ['Reads like Graphics', 'Add shapes to the path, then fill or stroke them. Calls chain.'],
    ['Edges from distance', 'Coverage comes from the exact distance to the shape, per pixel.'],
    ['Paint on any shape', 'Gradients in OKLab, blur, glows and inner shadows on fills and strokes.'],
    ['UI on top', 'Text, layout, widgets and editor tools ship as separate entry points.'],
];
const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<Base title={`${SITE.name}: smooth, anti-aliased graphics for PixiJS v8`} description={SITE.description} path="/" jsonLd={[webSiteLd(), softwareApplicationLd(), softwareLd(), breadcrumbLd([{ name: SITE.name, url: '/' }])]}>
    <section class="relative overflow-hidden border-b" data-pagefind-body data-pagefind-filter="section:Home">
        <div class="grid-bg pointer-events-none absolute inset-0 opacity-70"></div>
        <div class="container-page relative pb-14 pt-16 sm:pb-20 sm:pt-24">
            <div class="eyebrow">Version {SILK_VERSION} for PixiJS v8</div>
            <h1 class="display-1 mt-5 max-w-[15ch] sm:max-w-none">
                Anti-aliased graphics<br class="hidden sm:block" /> for PixiJS v8, <span class="silk-text">smooth as silk.</span>
            </h1>
            <p class="lead mt-6 max-w-2xl">
                pixi-silk draws PixiJS shapes as exact distance fields, so every edge is anti-aliased per pixel at any zoom.
                You use it like Graphics, with gradients, glows, text and UI widgets on top.
            </p>
            <div class="mt-9 flex flex-wrap items-center gap-3">
                <a href={start} class="btn btn-primary">
                    Get started
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                </a>
                {examples && <a href={examples.href} class="btn btn-outline">See the examples</a>}
                <CopyCommand command="npm i pixi-silk pixi.js" />
            </div>
        </div>
        <div class="container-page relative pb-16 sm:pb-20">
            <div class="h-[300px] overflow-hidden rounded-2xl border bg-[#070708] shadow-[0_30px_80px_-40px_rgba(124,58,237,0.45)] max-[900px]:h-[400px]">
                <HeroCanvas client:idle />
            </div>
        </div>
    </section>

    {features && (
        <section class="border-b">
            <div class="container-page py-20 sm:py-24">
                <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
                    <div>
                        <div class="eyebrow">{features.title}</div>
                        <h2 class="display-2 mt-3 max-w-2xl">What you can draw with it.</h2>
                    </div>
                    <p class="max-w-sm text-muted-foreground">{features.summary} Each page opens on live demos with their source.</p>
                </div>
                <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {features.areas.map((a) => (
                        <ThumbCard size="lg" href={a.href} title={a.title} description={a.summary} thumb={areaThumb(a)} badge={a.experimental ? 'Experimental' : undefined} />
                    ))}
                    <a href={features.href} class="card-link group flex min-h-40 flex-col justify-between p-6">
                        <div class="eyebrow">All features</div>
                        <div>
                            <div class="heading-4">{features.areas.reduce((n, a) => n + a.pages.length, 0)} pages, one per feature</div>
                            <span class="link-arrow mt-3">
                                Browse them
                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    )}

    <section class="border-b" data-pagefind-body data-pagefind-filter="section:Home">
        <div class="container-page grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
            <div>
                <div class="eyebrow">API</div>
                <h2 class="display-2 mt-3">One object draws the scene.</h2>
                <dl class="mt-8 divide-y border-y">
                    {points.map(([term, text]) => (
                        <div class="py-3.5">
                            <dt class="inline font-semibold">{term}.</dt>
                            <dd class="inline text-muted-foreground"> {text}</dd>
                        </div>
                    ))}
                </dl>
                <a href={start} class="btn btn-outline mt-8">Draw your first scene</a>
            </div>
            <div class="min-w-0 overflow-hidden rounded-xl border border-[hsl(var(--code-border))] bg-[hsl(var(--code-bg))]">
                <div class="flex items-center gap-2 border-b border-[hsl(var(--code-border))] px-4 py-2.5 font-mono text-xs text-white/55">
                    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
                    first-scene.ts
                </div>
                <Code code={code} lang="ts" theme="github-dark-dimmed" class="home-code overflow-x-auto px-5 py-4 text-[13px] leading-[1.7]" />
            </div>
        </div>
    </section>

    {examples && examplePages.length > 0 && (
        <section>
            <div class="container-page py-20 sm:py-24">
                <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
                    <div>
                        <div class="eyebrow">{examples.title}</div>
                        <h2 class="display-2 mt-3 max-w-2xl">Whole screens, with the source.</h2>
                    </div>
                    <a href={examples.href} class="link-arrow">
                        All examples
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                    </a>
                </div>
                <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    {examplePages.slice(0, 3).map((p) => <ThumbCard href={p.href} title={p.title} description={p.description} thumb={pageThumb(p)} />)}
                    <ThumbCard href="/studio/" title="Studio" description="Every demo as code next to its canvas. Edit the source and it runs again." thumb={siteThumb('studio')} />
                </div>
            </div>
        </section>
    )}
</Base>
