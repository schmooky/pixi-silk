---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { SHEETS } from '@/lib/showcase';
import { SITE } from '@/lib/site';

const description = 'Five design sheets, from Health cards to Live Activities, rebuilt pixel for pixel with smooth, anti-aliased pixi-silk graphics. 81 live widgets.';
---

<Base title={`Smooth PixiJS widgets, rebuilt pixel for pixel | ${SITE.name}`} description={description} path="/showcase/" jsonLd={[breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Showcase', url: '/showcase/' }])]}>
    <div class="container-page py-14" data-pagefind-body data-pagefind-filter="section:Showcase">
        <h1 class="text-4xl font-semibold tracking-tight">Showcase</h1>
        <p class="mt-3 max-w-3xl text-muted-foreground">
            {description} Each pair shows the reference image on the left and a still frame of the live render on the right.
            Open a sheet to drag a compare slider over it, or use the <a class="underline" href="/lab/35-widget-viewer/">widget viewer</a> to inspect any widget up close.
            More complete scenes are in the <a class="underline" href="/docs/examples/">Examples</a> area.
        </p>
        <div class="mt-12 space-y-16">
            {SHEETS.map((s, i) => (
                <section id={s.slug}>
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h2 class="text-2xl font-semibold tracking-tight">Sheet {s.n}: {s.title}</h2>
                        <a href={`/lab/${s.slug}/`} class="text-sm text-muted-foreground hover:text-foreground">Open the live sheet</a>
                    </div>
                    <p class="mt-2 max-w-3xl text-sm text-muted-foreground">{s.body}</p>
                    <a href={`/lab/${s.slug}/`} class="mt-5 block overflow-hidden rounded-xl border">
                        <Picture src={s.image} alt={s.alt} formats={['avif', 'webp']} widths={[800, 1200, 1600]} sizes="(min-width: 1240px) 1192px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} class="h-auto w-full" />
                    </a>
                </section>
            ))}
        </div>
    </div>
</Base>
