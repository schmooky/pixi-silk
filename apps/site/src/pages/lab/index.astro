---
import { VISIBLE_AREAS } from '@/content/nav.mjs';
import { LAB_SECTIONS } from '@/lab/catalog.mjs';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

// the docs area whose overview links to each experiment
const areaOf = new Map(VISIBLE_AREAS.flatMap((a) => (a.lab ?? []).map((slug) => [slug, a] as const)));
const description = 'Full-screen anti-aliasing experiments for PixiJS v8: Graphics vs SDF, infinite zoom, sub-pixel motion, gradients, glows, live widgets and a stress test.';
---

<Base title={`Lab: PixiJS anti-aliasing experiments and demos | ${SITE.name}`} description={description} path="/lab/" jsonLd={[breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Lab', url: '/lab/' }])]}>
    <div class="container-page py-14" data-pagefind-body data-pagefind-filter="section:Lab">
        <h1 class="text-4xl font-semibold tracking-tight">Lab</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground">{description} Every page has a pixel loupe: press <kbd class="rounded border px-1 font-mono text-xs">L</kbd> and hover to see real device pixels.</p>
        <p class="mt-2 max-w-2xl text-sm text-muted-foreground">The lab goes deeper than the <a class="underline underline-offset-4 hover:text-foreground" href="/docs/">docs</a>. Each docs area links to the experiments on its topic, and each experiment below links back to its area.</p>
        {LAB_SECTIONS.map(([title, items]) => (
            <section class="mt-12">
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{title}</h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    {items.map(([slug, name, desc]) => (
                        <div class="relative flex flex-col rounded-xl border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground/30">
                            <div class="font-mono text-[11px] text-silk">{slug.slice(0, 2)}</div>
                            <a href={`/lab/${slug}/`} class="mt-1.5 font-semibold after:absolute after:inset-0">{name}</a>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{desc}</p>
                            {areaOf.has(slug) && (
                                <a href={`/docs/${areaOf.get(slug)!.id}/`} class="relative z-10 mt-3 self-start text-xs text-muted-foreground hover:text-foreground">Guides: {areaOf.get(slug)!.title}</a>
                            )}
                        </div>
                    ))}
                </div>
            </section>
        ))}
    </div>
</Base>
