---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found | pixi-silk" description="This page does not exist." noIndex>
    <div class="container-page py-32 text-center">
        <h1 class="text-5xl font-semibold tracking-tight">404</h1>
        <p class="mt-4 text-muted-foreground">That page does not exist. Try the <a class="underline" href="/docs/">docs</a> or the <a class="underline" href="/docs/examples/">examples</a>.</p>
    </div>
</Base>
