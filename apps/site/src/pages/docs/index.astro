---
import { docsSections, pageThumb } from '@/components/sections';
import ThumbCard from '@/components/ThumbCard.astro';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const sections = await docsSections();
const description = `Guides for ${SITE.name}: learn the basics, then read one page per feature, from shapes and gradients to UI widgets and editor tools.`;
const learn = sections.find((s) => s.id === 'learn');
const first = learn?.areas[0]?.pages[0];
---

<Base title={`Docs: smooth, anti-aliased graphics for PixiJS v8 | ${SITE.name}`} description={description} path="/docs/" jsonLd={[breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Docs', url: '/docs/' }])]}>
    <div data-pagefind-body data-pagefind-filter="section:Docs">
        <header class="border-b">
            <div class="container-page py-16 sm:py-20">
                <div class="eyebrow">Documentation</div>
                <h1 class="display-2 mt-3 max-w-3xl">Everything pixi-silk draws, one page at a time.</h1>
                <p class="lead mt-5 max-w-2xl">{description} Every page opens with live demos you can edit in Studio.</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    {first && <a href={first.href} class="btn btn-primary">Start with {first.title.toLowerCase()}</a>}
                    <a href="/studio/" class="btn btn-outline">Open Studio</a>
                </div>
                <nav aria-label="Sections" class="mt-10 flex flex-wrap gap-2" data-pagefind-ignore>
                    {sections.map((s) => (
                        <a href={`#${s.id}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground">{s.title}</a>
                    ))}
                </nav>
            </div>
        </header>

        {sections.map((s) => (
            <section id={s.id} class="scroll-mt-14 border-b last:border-b-0">
                <div class="container-page py-16">
                    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
                        <div>
                            <div class="eyebrow">{s.title}</div>
                            <h2 class="display-3 mt-2"><a href={s.href} class="hover:text-silk-text">{s.summary}</a></h2>
                        </div>
                        <a href={s.href} class="link-arrow">
                            {s.title} overview
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                        </a>
                    </div>
                    {s.areas.map((a) => (
                        <div id={a.id !== s.id ? a.id : undefined} class="mt-10 scroll-mt-20">
                            {a.aliases.map((id) => <span id={id} class="block scroll-mt-20" />)}
                            {s.areas.length > 1 && (
                                <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <h3 class="heading-4 flex items-center gap-2"><a href={a.href} class="hover:text-silk-text">{a.title}</a>{a.experimental && <span class="badge">Experimental</span>}</h3>
                                    <p class="text-sm text-muted-foreground">{a.summary}</p>
                                </div>
                            )}
                            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                                {a.pages.map((p) => <ThumbCard href={p.href} title={p.title} description={p.description} thumb={pageThumb(p)} />)}
                                {a.links.map((l) => (
                                    <a href={l.href} class="card-link flex flex-col justify-end p-4">
                                        <div class="font-semibold">{l.label}</div>
                                        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{l.description}</p>
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        ))}
    </div>
</Base>
