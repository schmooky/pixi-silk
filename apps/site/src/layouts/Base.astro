---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import SEO from '@/components/SEO.astro';
import { BUILD_ID } from '@/lib/build-id.mjs';
import { ogUrlForPath, type PageSeo } from '@/lib/seo';
import { SITE } from '@/lib/site';
import '@/styles/global.css';

type Props = Partial<PageSeo>;
const {
    title = `${SITE.name}: ${SITE.tagline}`,
    description = SITE.description,
    path = Astro.url.pathname,
    image,
    type,
    article,
    keywords,
    markdown,
    jsonLd,
    noIndex,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta name="silk-build" content={BUILD_ID} />
        <script is:inline>
            // dark unless the visitor chose light: set before first paint so nothing flashes
            document.documentElement.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
        </script>
        {/* A deploy replaces the hashed script files, so a page loaded before it can fail to import them
            (the host then answers with HTML). Reload once to get the new page; the flag stops loops. */}
        <script is:inline>
            window.silkRecover = (error) => {
                const stale = /Importing a module script failed|Failed to fetch dynamically imported module|error loading dynamically imported module|Unable to preload CSS/i;
                if (!stale.test(String(error?.message ?? error))) return false;
                return window.silkRefresh();
            };
            // Fetch the page again past the HTTP cache, then reload, so the reload gets the new HTML
            // and not the cached copy that points at deleted scripts. Once per page and build.
            window.silkRefresh = (build) => {
                const key = `${location.pathname}@${build ?? ''}`;
                try {
                    if (sessionStorage.getItem('silk-reloaded') === key) return false;
                    sessionStorage.setItem('silk-reloaded', key);
                } catch {
                    return false;
                }
                fetch(location.href, { cache: 'reload', credentials: 'same-origin' }).finally(() => location.reload());
                return true;
            };
            // A page from an older deploy, served from a cache: ask which build is live and refresh.
            addEventListener('load', () => {
                const mine = document.querySelector('meta[name="silk-build"]')?.content;
                fetch('/version.json', { cache: 'no-store' })
                    .then((r) => (r.ok ? r.json() : null))
                    .then((v) => { if (mine && v?.build && v.build !== mine) window.silkRefresh(v.build); })
                    .catch(() => {});
            });
            addEventListener('unhandledrejection', (e) => { if (window.silkRecover(e.reason)) e.preventDefault(); });
            addEventListener('vite:preloadError', (e) => { if (window.silkRecover(e.payload)) e.preventDefault(); });
        </script>
        {/* Some static hosts (Timeweb's frontend apps) answer unknown URLs with the home page.
            Send those visitors to the real 404 page, which is noindex. */}
        {path === '/' && (
            <script is:inline>
                if (location.pathname !== '/' && location.pathname !== '/index.html') location.replace('/404.html');
            </script>
        )}
        <SEO title={title} description={description} path={path} image={image ?? ogUrlForPath(path)} type={type} article={article} keywords={keywords} markdown={markdown} jsonLd={jsonLd} noIndex={noIndex} />
        <link rel="preload" href="/fonts/Inter-400.woff" as="font" type="font/woff" crossorigin />
    </head>
    <body class="min-h-screen font-sans">
        <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
        <Nav />
        <main id="content"><slot /></main>
        <Footer />
    </body>
</html>
