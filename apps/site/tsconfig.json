{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "pixi-silk": ["../../packages/pixi-silk/src/index.ts"],
      "pixi-silk/signal": ["../../packages/pixi-silk/src/signal.ts"],
      "pixi-silk/glass": ["../../packages/pixi-silk/src/glass.ts"],
      "pixi-silk/glow": ["../../packages/pixi-silk/src/glow.ts"],
      "pixi-silk/webgpu": ["../../packages/pixi-silk/src/webgpu.ts"],
      "pixi-silk/text": ["../../packages/pixi-silk/src/text.ts"],
      "pixi-silk/selection": ["../../packages/pixi-silk/src/selection.ts"],
      "pixi-silk/history": ["../../packages/pixi-silk/src/history.ts"],
      "pixi-silk/path": ["../../packages/pixi-silk/src/path.ts"],
      "pixi-silk/ui": ["../../packages/pixi-silk/src/ui/index.ts"],
      "pixi-silk/ui/radial": ["../../packages/pixi-silk/src/ui/RadialMenu.ts"],
      "pixi-silk/ui/button": ["../../packages/pixi-silk/src/ui/SilkButton.ts"],
      "pixi-silk/ui/dock": ["../../packages/pixi-silk/src/ui/ButtonDock.ts"],
      "pixi-silk/ui/*": ["../../packages/pixi-silk/src/ui/*.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*", "astro.config.mjs", ".astro/types.d.ts"],
  "exclude": ["dist", "src/pages/api"]
}
