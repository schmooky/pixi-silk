{
  "name": "@pixi-silk/shaper-kb",
  "version": "0.1.0",
  "description": "Runtime shaper for pixi-silk text slots: kb_text_shape in WebAssembly shapes values with the baked font and draws them as SDF run sprites.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kb.wasm": "./dist/kb.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && cp wasm/kb.wasm dist/kb.wasm",
    "build:wasm": "sh wasm/build.sh",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "pixi-silk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "harfbuzzjs": "1.6.4",
    "pixi-silk": "workspace:*",
    "pixi.js": "^8.21.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/pixi-silk.git",
    "directory": "packages/shaper-kb"
  }
}
