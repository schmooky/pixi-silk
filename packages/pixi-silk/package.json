{
  "name": "pixi-silk",
  "version": "0.1.0",
  "description": "Smooth vector graphics for PixiJS v8: analytic anti-aliased SDF primitives, squircles, arcs, polylines, dashes, OKLab gradients, glows and DPR-exact canvases, one draw call per object.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signal": {
      "types": "./dist/signal.d.ts",
      "default": "./dist/signal.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/radial": {
      "types": "./dist/ui/RadialMenu.d.ts",
      "default": "./dist/ui/RadialMenu.js"
    },
    "./ui/button": {
      "types": "./dist/ui/SilkButton.d.ts",
      "default": "./dist/ui/SilkButton.js"
    },
    "./ui/dock": {
      "types": "./dist/ui/ButtonDock.d.ts",
      "default": "./dist/ui/ButtonDock.js"
    },
    "./ui/gizmo": {
      "types": "./dist/ui/gizmo.d.ts",
      "default": "./dist/ui/gizmo.js"
    },
    "./ui/outline": {
      "types": "./dist/ui/outline.d.ts",
      "default": "./dist/ui/outline.js"
    },
    "./ui/camera": {
      "types": "./dist/ui/camera.d.ts",
      "default": "./dist/ui/camera.js"
    },
    "./ui/measure": {
      "types": "./dist/ui/measure.d.ts",
      "default": "./dist/ui/measure.js"
    },
    "./ui/grid": {
      "types": "./dist/ui/grid.d.ts",
      "default": "./dist/ui/grid.js"
    },
    "./ui/ruler": {
      "types": "./dist/ui/ruler.d.ts",
      "default": "./dist/ui/ruler.js"
    },
    "./ui/guides": {
      "types": "./dist/ui/guides.d.ts",
      "default": "./dist/ui/guides.js"
    },
    "./ui/marquee": {
      "types": "./dist/ui/marquee.d.ts",
      "default": "./dist/ui/marquee.js"
    },
    "./ui/group": {
      "types": "./dist/ui/group.d.ts",
      "default": "./dist/ui/group.js"
    },
    "./ui/spacing": {
      "types": "./dist/ui/spacing.d.ts",
      "default": "./dist/ui/spacing.js"
    },
    "./ui/snap": {
      "types": "./dist/ui/snap.d.ts",
      "default": "./dist/ui/snap.js"
    },
    "./ui/color": {
      "types": "./dist/ui/color.d.ts",
      "default": "./dist/ui/color.js"
    },
    "./ui/halo": {
      "types": "./dist/ui/halo.d.ts",
      "default": "./dist/ui/halo.js"
    },
    "./ui/brush": {
      "types": "./dist/ui/brush.d.ts",
      "default": "./dist/ui/brush.js"
    },
    "./ui/modes": {
      "types": "./dist/ui/modes.d.ts",
      "default": "./dist/ui/modes.js"
    },
    "./ui/dial": {
      "types": "./dist/ui/dial.d.ts",
      "default": "./dist/ui/dial.js"
    },
    "./ui/timeline": {
      "types": "./dist/ui/timeline.d.ts",
      "default": "./dist/ui/timeline.js"
    },
    "./ui/odometer": {
      "types": "./dist/ui/odometer.d.ts",
      "default": "./dist/ui/odometer.js"
    },
    "./ui/gesture": {
      "types": "./dist/ui/gesture.d.ts",
      "default": "./dist/ui/gesture.js"
    },
    "./ui/arc": {
      "types": "./dist/ui/arc.d.ts",
      "default": "./dist/ui/arc.js"
    },
    "./ui/keys": {
      "types": "./dist/ui/keys.d.ts",
      "default": "./dist/ui/keys.js"
    },
    "./ui/pill": {
      "types": "./dist/ui/pill.d.ts",
      "default": "./dist/ui/pill.js"
    },
    "./glass": {
      "types": "./dist/glass.d.ts",
      "default": "./dist/glass.js"
    },
    "./glow": {
      "types": "./dist/glow.d.ts",
      "default": "./dist/glow.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "default": "./dist/webgpu.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/stage-package-files.mjs",
    "postpack": "node ../../scripts/stage-package-files.mjs --clean"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "pixi.js": "^8.21.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "author": "schmooky",
  "homepage": "https://pixi-silk.schmooky.dev",
  "bugs": {
    "url": "https://github.com/schmooky/pixi-silk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/pixi-silk.git",
    "directory": "packages/pixi-silk"
  },
  "keywords": [
    "pixi",
    "pixijs",
    "pixi.js",
    "graphics",
    "vector",
    "antialiasing",
    "anti-aliasing",
    "sdf",
    "signed-distance-field",
    "shader",
    "webgl",
    "webgpu",
    "squircle",
    "gradient",
    "oklab",
    "charts",
    "retina",
    "hidpi",
    "typescript"
  ]
}
